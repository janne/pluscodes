{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "target": "es6",
    "module": "node16",
    "moduleResolution": "node16",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "types": ["jest", "node"]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/*.spec.ts",
    "dist",
    "node_modules"
  ]
}